{
  "info": {
    "name": "SafeHub - CRUD de Clientes",
    "description": "Login via Supabase seguido dos testes autenticados de listar, criar, consultar, atualizar e excluir clientes. Execute a coleção na ordem apresentada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Login Supabase (automático)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{publishableKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login no Supabase concluído', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('accessToken', body.access_token);",
              "  console.log('Token de acesso salvo apenas no ambiente Postman ativo.');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Listar clientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clientes?limit=20&offset=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listagem de clientes respondeu 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Criar cliente de teste",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente criado pelo Postman\",\n  \"setor\": \"Tecnologia\",\n  \"status_pipeline\": \"novo\",\n  \"responsavel_id\": null\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/clientes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cliente criado (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  pm.environment.set('clientId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Consultar cliente criado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clientes/{{clientId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Consulta do cliente respondeu 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Atualizar cliente criado",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"setor\": \"Tecnologia - atualizado pelo Postman\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/clientes/{{clientId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cliente atualizado respondeu 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Excluir cliente criado",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/clientes/{{clientId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cliente excluído (204)', function () { pm.response.to.have.status(204); });",
              "if (pm.response.code === 204) { pm.environment.unset('clientId'); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Outlook 1. Iniciar conexão (gera URL Microsoft)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/integracoes/outlook/connect",
        "description": "Execute depois do login. Copie authorizationUrl da resposta e abra no navegador para ver o consentimento Microsoft. O callback será implementado na próxima etapa."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('URL de autorização Outlook gerada', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  pm.environment.set('outlookAuthorizationUrl', pm.response.json().authorizationUrl);",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
